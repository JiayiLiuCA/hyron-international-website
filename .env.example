# Contact form email delivery (Resend). Without RESEND_API_KEY the form shows a
# friendly failure message with the public email address instead of sending.
RESEND_API_KEY=
# Inbox that receives inquiries (defaults to site.email in src/config/site.ts).
CONTACT_TO_EMAIL=info@hyroninternational.com
# Verified Resend sender on the hyroninternational.com domain.
CONTACT_FROM_EMAIL="HYRON Website <website@hyroninternational.com>"
